#!/bin/sh
# Refuses commit messages that name an AI assistant as a co-author.
# GitHub lists every Co-Authored-By trailer as a contributor on the repo page.
# Enable once per clone: git config core.hooksPath .githooks
if grep -i -q 'co-authored-by:.*\(claude\|anthropic\)' "$1"; then
  echo "commit-msg: remove the Co-Authored-By line naming an AI assistant. It makes it appear as a repo contributor." >&2
  exit 1
fi
